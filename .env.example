PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=staynestdb
# For Aiven, set DB_SSL_CA to the CA certificate downloaded from the service console.
# Or set DB_SSL_CA_PATH to the path of a CA certificate file available to the service.

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated exact frontend origins; do not use a wildcard.
CORS_ORIGINS=http://localhost:5173
